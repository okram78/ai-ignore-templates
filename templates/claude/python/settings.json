{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.venv/**)",
      "Read(./venv/**)",
      "Read(./env/**)",
      "Read(./__pycache__/**)",
      "Read(./.pytest_cache/**)",
      "Read(./.mypy_cache/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./*.egg-info/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.crt)",
      "Read(./**/*.log)"
    ]
  }
}
